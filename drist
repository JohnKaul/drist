# ---[ GLOBALS ]--------------------------------------------------
PRIVILEGES=0                  # Run with escalated privileges
PRIVILEGES_BIN=doas           # binary to run privileged command.
EXEC='exec sh -c'             # posix compliant shell.
TAR_EXEC=""                   # short exec when elevating permissions for tar commands, same as EXEC, except that defaults to ""
SSHONCE=0                     # set up a socket for persistent connection.
TRUNCATE=0                    # Remove the domain name from the hostname.
USE_FILE="script"             # default script file to upload if no optional switches.
USE_DIR="files"               # default directory to upload if no optional switches.
SSH_PARAMS=""                 # default ssh parameters.
COPY_FILE=""                  # default single file to copy.
TEMPDIR=""                    # assigned to in the create_temp() function
DEBUG=false                   # true or false
COPY_ROOT_DIR='$HOME'         # root directory to copy files to, defaults to $HOME
COPIED_FILE=""                # file copied to $COPY_ROOT_DIR/filename
COPIED_DIR=""                 # dir copied to $COPY_ROOT_DIR/directory
DELETE_COPIED_FILES=false     # delete the copied files/directories
NO_COPY=false                 # do not copy the file/directory from the remote temp dir to the remote copy_root_dir

# ---[ HELPERS ]--------------------------------------------------
##
# usage --
# @brief displays usage information.
usage() {
    echo "$0 v2.09"
    echo "$0 [-v] [-vv] [-n] [-p] [-d] [-x] [-e [sudo|doas]] [-r remote-root-dir] [-S script-to-run] [-f files-to-copy-directory] [-F single-file-to-copy] destination [...]"
    exit 0
}

debug(){
    if [ "$DEBUG" = true ]; then
        echo "[DEBUG] $@"
    fi
}

##
# copy_files --
# @brief Copy files from a local directory to a remote server.
#
# Parameters:
#   $1 - source directory (e.g. /local/path/to/upload/directory)
#   $2 - remote server name (e.g. server)
#   $3 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
copy_files() {
    src_dir=$1
    remote_server=$2
    remote_tmp=$3

    if [ -d "${src_dir}" ]; then
        if [ -z "${remote_server}" ]; then
            echo "remote_server is blank, exiting"
            exit 1
        fi
        if [ -z "${remote_tmp}" ]; then
            echo "remote_tmp is blank, exiting"
            exit 2
        fi
            
        # basename of source dir (e.g. files-server.local from /local/path/to/upload/directory)
        src_base=$(basename -- "${src_dir}")

        # global var used to delete the copied directory
        COPIED_DIR="${src_base}"

        # Copy files to remote host.
        tar cf - -C "$(dirname -- ${src_dir})" -- "${src_base}" | ssh $SSH_PARAMS "${remote_server}" 'tar xf - -C '"${remote_tmp}"

        if [ "$NO_COPY" = false ]; then
            # copy files from remote_tmp directory to the copy_root_dir
            ssh $SSH_PARAMS "${remote_server}" "tar cf - -C \"${remote_tmp}\" . | ${TAR_EXEC} tar xf - -C \"$COPY_ROOT_DIR\""
        fi
    fi
    debug "copy_files, src_dir: $src_dir, remote_server: $remote_server, remote_tmp: $remote_tmp, COPY_ROOT_DIR: $COPY_ROOT_DIR, COPIED_DIR: $COPIED_DIR, TAR_EXEC: $TAR_EXEC"
}

##
# copy_single_file --
# @brief Copy a single file from a local directory to a remote server.
#
# Parameters:
#   $1 - source file (e.g. /local/path/to/upload.file)
#   $2 - remote server name (e.g. server)
#   $3 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
#
# NOTE: Even in the case when a single file is copied to remote host
#       if a file/directory is labeled with the 'HOSTNAME' string in
#       the same directory as the single file, it will be copied as
#       well.
copy_single_file() {
    src_file=$1
    remote_server=$2
    remote_tmp=$3

    if [ -f "${src_file}" ]; then
        if [ -z "${remote_server}" ]; then
            echo "remote_server is blank, exiting"
            exit 3
        fi
        if [ -z "${remote_tmp}" ]; then
            echo "remote_tmp is blank, exiting"
            exit 4
        fi
            
        # Get the current working directory.
        file_name=$(basename -- "$src_file")

        # global used to delete the file
        COPIED_FILE="${file_name}"

        # copy file to remote host.
        tar cf - -C "$(dirname -- "$src_file")" "./${file_name}" | ssh $SSH_PARAMS "${remote_server}" 'tar xf - -C '"${remote_tmp}"

        # copy files from remote_tmp directory to the copy_root_dir
        if [ "$NO_COPY" = false ]; then
            ssh $SSH_PARAMS "${remote_server}" "tar cf - -C \"$remote_tmp\" . | ${TAR_EXEC} tar xf - -C \"$COPY_ROOT_DIR\""
        fi
    fi
    debug "copy_single_file, src_dir: $src_dir, remote_server: $remote_server, remote_tmp: $remote_tmp, COPY_ROOT_DIR: $COPY_ROOT_DIR, COPIED_FILE: $COPIED_FILE TAR_EXEC: $TAR_EXEC"
}

##
# remote_script --
# @brief Executes script on remote host.
#
# Parameters:
#   $1 - script file (e.g. /local/path/to/script/to/invoke/on/remote/server)
#   $2 - remote server name (e.g. server)
#   $3 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
remote_script() {
    script_file=$1
    remote_server=$2
    remote_tmp=$3

    debug "remote_script, script_file: $script_file, remote_server: $remote_server, remote_temp: $remote_tmp, EXEC: $EXEC"

    if [ -f "${script_file}" ]; then
        if [ -z "${remote_server}" ]; then
            echo "remote_server is blank, exiting"
            exit 5
        fi
        if [ -z "${remote_tmp}" ]; then
            echo "remote_tmp is blank, exiting"
            exit 6
        fi
            
        file_name=$(basename ${script_file})
        ssh $SSH_PARAMS "${remote_server}" "cd ${remote_tmp} && \
            cat - > ${remote_tmp}/${file_name} && \
            chmod u+x ${remote_tmp}/${file_name} && \
            ${EXEC} ${remote_tmp}/${file_name}" < "$script_file"
    fi
}

##
# delete_on_exit --
# @brief Delete copied file and/or directory on exit.
#
# Parameters:
delete_copied_files() {
    remote_server=$1
    debug "delete_copied_files, remote_server: $remote_server, delete_copied_files: $DELETE_COPIED_FILES, copy_root_dir: $COPY_ROOT_DIR, copied_file: $COPIED_FILE, copied_dir: $COPIED_DIR, EXEC: $EXEC"
    if [ "$DELETE_COPIED_FILES" = true ]; then
        if [ -n "$COPIED_FILE" ]; then
            ssh $SSH_PARAMS "${remote_server}" "${EXEC} rm $COPY_ROOT_DIR/$COPIED_FILE"
            debug "deleted file: $remote_server:$COPY_ROOT_DIR/$COPIED_FILE"
        fi
        if [ -n "$COPIED_DIR" ]; then
            ssh $SSH_PARAMS "${remote_server}" "${EXEC} rm -rf $COPY_ROOT_DIR/$COPIED_DIR"
            debug "deleted dir: $remote_server:$COPY_ROOT_DIR/$COPIED_DIR"
        fi
    fi
}


##
# create_temp --
# @brief Creates temporary directory on remote host.
#
# Parameters:
#   $1 - remote server name (e.g. server)
#
# NOTE: assigns value to global var
create_temp() {
    remote_server=$1

    debug "create_temp, remote_server: $remote_server"
    
    if [ -z "${remote_server}" ]; then
        echo "remote_server is blank, exiting"
        exit 7
    fi
    TEMPDIR=$(ssh $SSH_PARAMS "${remote_server}" "mktemp -d ~/.drist_files_XXXXXXXXXXXXXXX")
    if [ -z "$TEMPDIR" ]; then
        echo "mktemp error, TEMPDIR is not set, aborting"
        exit 8
    else
        debug "created temp dir: $TEMPDIR on remote server: ${remote_server}"
    fi
}

##
# delete_temp --
# @brief Deletes temporary directory on remote host.
#
# Parameters:
#   $1 - remote server name (e.g. server)
#   $2 - remote tempdir target (e.g. ~/.drist_files_XXXXXXXXXXXXXXX)
delete_temp() {
    remote_server=$1
    remote_tmp=$2

    debug "delete_temp, remote_server: $remote_server, remote_tmp: $remote_tmp"

    if [ -z "${remote_server}" ]; then
        echo "remote_server is blank, exiting"
        exit 9
    fi
    if [ -z "${remote_tmp}" ]; then
        echo "remote_tmp is blank, exiting"
        exit 10
    fi
    if echo "${remote_tmp}" | grep drist_files_ >/dev/null ; then
        ssh $SSH_PARAMS "$remote_server" "rm -fr ${remote_tmp}"
        debug "deleted temp dir: $remote_tmp on remote server: ${remote_server}"
    else
        echo "Problem, temp dir was reset during execution, current value is = $remote_tmp"
        exit 11
    fi
}


# ---[ ARGUMENT PARSER ]------------------------------------------
# (custom getopt() like argument parser)

# check to see if we have enough arguments.
if [ $# -lt 1 ]; then echo "Not enough arguments."; fi

# flag to set when done processing arguments.
done_options=

##
# @brief check to see if there are more arguments to parse.
#
# @return 1 if done 0 if more args.
more_options() {
    test $done_options && return 1
    [ $# -eq 0 ] && return 1
    case "$1" in
        --) return 1 ;;   # stop options
        -*) return 0 ;;
        *) return 1 ;;
    esac
}

# parse arguments.
while more_options "$1"
do
    case "$1" in
        --)
            done_options=1
            shift
            break
            ;;
        -h*)                                            # Help
            usage
            ;;
        -v)                                             # enable debug logging
            DEBUG=true
            ;;
        -vv)                                            # enable debug verbose logging
            set -x
            ;;
        -d)                                             # truncate hostname
            TRUNCATE=1
            ;;
        -n)                                             # do not copy files out of the .drist temp dir
            NO_COPY=true                                # instead, the script can use them directly in the temp dir
            ;;
        -r)                                             # root directory to copy files to, defaults to $HOME
            [ $# -gt 1 ] || usage "-r requires a root directory to copy files to"
            shift
            old_copy_root_dir="$COPY_ROOT_DIR"
            COPY_ROOT_DIR="$1"
            debug "COPY_ROOT_DIR changed from default $old_copy_root_dir to $COPY_ROOT_DIR"
            ;;
        -p)                                             # persistent ssh
            SSHONCE=1
            ;;
        -x)                                             # delete copied files when script finishes
            DELETE_COPIED_FILES=true
            ;;
        -S)                                             # script file to run
            [ $# -gt 1 ] || usage "-S requires a script name"
            shift
            USE_FILE="$1"
            ;;
        -f)                                             # directory of files to upload
            [ $# -gt 1 ] || usage "-f requires a directory location"
            shift
            USE_DIR="$1"
            ;;
        -F)                                             # file to upload
            [ $# -gt 1 ] || usage "-F requires a file name"
            shift
            COPY_FILE="$1"
            ;;
        -e*)                                            # elevate permissions.
            if [ $# -gt 1 ] && case "$2" in -*) false;; *) true;; esac; then
                shift
                PRIVILEGES_BIN="${1#-e}"
            fi
            PRIVILEGES=1
            debug "privileges, PRIVILEGES_BIN: $PRIVILEGES_BIN, PRIVILEGES=$PRIVILEGES"
            ;;
        -*)
            usage "unknown option $1"
            ;;
    esac
    shift
done

# ---[ RUNTIME ]--------------------------------------------------
# allow to use a privilege escalation program
if [ "$PRIVILEGES" -eq 1 ]; then
    EXEC="$PRIVILEGES_BIN"
    TAR_EXEC="$PRIVILEGES_BIN"
    debug "EXEC: $EXEC, TAR_EXEC: $TAR_EXEC"
fi

# use ControlMaster to make connections persistent
if [ "$SSHONCE" -eq 1 ]; then
   SSH_PARAMS='-o ControlMaster=auto -o ControlPath=/tmp/drist_ssh_%h_%p_%r.sock -o ControlPersist=1m'
   debug "ssh_params: $SSH_PARAMS"
fi

# start looping over server list
if [ -f "$1" ]; then
    SERVER_LIST="$(tr '\n' ' ' < $1)"
else
    SERVER_LIST="$@"
fi
debug "server_list: $SERVER_LIST"

if [ "${SERVER_LIST}" = "" ]; then
    echo "No server specified"
    exit 12
fi

for remote_server in ${SERVER_LIST}
do

  debug "processing server: $remote_server"
  # check if host exists
  HOSTNAME=$(ssh $SSH_PARAMS "$remote_server" "uname -n")
  if [ "$?" -ne 0 ]; then
      echo "Error while ssh ${remote_server}"
      exit 13
  fi

  if [ "$TRUNCATE" -eq 1 ]; then
      HOSTNAME="${HOSTNAME%%.*}"
  fi

  # assigns value to TEMPDIR
  create_temp "${remote_server}"
  copy_files "${USE_DIR}" "${remote_server}" "$TEMPDIR"
  copy_files "${USE_DIR}-${HOSTNAME}" "${remote_server}" "$TEMPDIR"
  copy_single_file "${COPY_FILE}" "${remote_server}" "$TEMPDIR"
  copy_single_file "${COPY_FILE}-${HOSTNAME}" "${remote_server}" "$TEMPDIR"
  remote_script "${USE_FILE}" "${remote_server}" "$TEMPDIR"
  remote_script "${USE_FILE}-${HOSTNAME}" "${remote_server}" "$TEMPDIR"
  delete_temp "${remote_server}" "$TEMPDIR"
  if [ "$DELETE_COPIED_FILES" = true ]  && [ "$NO_COPY" = false ]; then
    delete_copied_files "${remote_server}"
  fi

  # close socket if persistence is active
  if [ "$SSHONCE" -eq 1 ]; then
      ssh $SSH_PARAMS -O exit -N "$1"
  fi

  unset TEMPDIR HOSTNAME
done
